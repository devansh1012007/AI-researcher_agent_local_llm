# GAR research platform - environment template (copy to .env; never commit real secrets)
# --- LLM providers ---
GAR_MODELS__EXTRACTOR__PROVIDER=ollama
GAR_MODELS__EXTRACTOR__MODEL=qwen2.5:7b-instruct
GAR_MODELS__REASONING__PROVIDER=ollama
GAR_MODELS__REASONING__MODEL=qwen2.5:14b-instruct
# GAR_MODELS__SYNTHESIS__BASE_URL=http://127.0.0.1:11434/v1

# --- Search ---
GAR_SEARCH__WEB_PROVIDER=duckduckgo        # duckduckgo | searxng | none (offline)
GAR_SEARCH__SEARXNG_BASE_URL=
GAR_SEARCH__SEMANTIC_SCHOLAR_API_KEY=

# --- Platform security ---
GAR_PLATFORM__API__HOST=127.0.0.1          # non-local requires a token below
GAR_PLATFORM__API__AUTH_TOKEN=
GAR_PLATFORM__SECURITY__PRIVACY_MODE=false # true = never call out (#99)
GAR_PLATFORM__MODE=hybrid                  # local | hybrid | online

# --- Storage ---
GAR_STORAGE__DATA_DIR=research_data
