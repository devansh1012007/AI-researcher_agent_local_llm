+        q_tokens = {w for w in _re.findall(r"[a-z0-9]+", q_low) if len(w) > 2}
+        o_tokens = {w for w in _re.findall(r"[a-z0-9]+", o_low) if len(w) > 2}
+        overlap = len(q_tokens & o_tokens) / max(1, len(q_tokens))
