    "pain_statement": { "type": "string" },
    "frequency_signal": {
      "type": "string",
      "enum": ["one_off", "occasional", "recurring", "daily", "unknown"]
    },
    "current_workaround": { "type": "string" },
    "competitor_or_alternative": { "type": "string" },
    "pricing_raw": { "type": "string" },
    "demand_signal_type": {
      "type": "string",
      "enum": ["casual_opinion", "survey_intention", "interview_evidence", "prototype_usage", "repeated_behavioral_usage", "payment", "none"]
